    {
      "name": "01 - Registrar Cliente Válido (Caso 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {\n    pm.response.to.have.status(201);\n});\nvar jsonData = pm.response.json();\npm.test(\"Rol predeterminado es Cliente\", function () {\n    pm.expect(jsonData.rol).to.eql(\"Cliente\");\n});\nif (jsonData.usuarioId) {\n    pm.collectionVariables.set(\"cliente_id\", jsonData.usuarioId);\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Emili\",\n  \"correo\": \"emily07morocho11@gmail.com\",\n  \"password\": \"Dayana1234*\",\n  \"confirmarPassword\": \"Dayana1234*\",\n  \"telefono\": \"0987654321\",\n  \"ciudad\": \"Quito\"\n}",
