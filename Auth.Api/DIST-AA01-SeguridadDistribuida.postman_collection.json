	"item": [
		{
			"name": "01 - Registrar Cliente Válido (Caso 1)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"var jsonData = pm.response.json();",
							"pm.test(\"Rol predeterminado es Cliente\", function () {",
							"    pm.expect(jsonData.rol).to.eql(\"Cliente\");",
							"});",
							"if (jsonData.usuarioId) {",
							"    pm.collectionVariables.set(\"cliente_id\", jsonData.usuarioId);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"nombres\": \"Juan Perez Cliente\",\n  \"correo\": \"{{cliente_email}}\",\n  \"password\": \"{{cliente_password}}\",\n  \"confirmarPassword\": \"{{cliente_password}}\",\n  \"telefono\": \"0987654321\",\n  \"ciudad\": \"Quito\"\n}"
